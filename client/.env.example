# ==============================================================================
# NEXUS OS • FRONTEND PRODUCTION ENVIRONMENT CONFIGURATION
# (Deploy on: Vercel, Netlify, Cloudflare Pages, etc.)
# ==============================================================================

# Public URL of your deployed unified backend service (DO NOT include trailing slash)
VITE_API_URL=https://your-backend.onrender.com

# Optional: Specific Social API base URL (Defaults automatically to $VITE_API_URL/social-api)
VITE_SOCIAL_API_URL=https://your-backend.onrender.com/social-api

# ------------------------------------------------------------------------------
# FIREBASE WEB CLIENT CONFIGURATION
# (Used for Google OAuth and user authentication)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=lyoo-7cc38.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lyoo-7cc38
VITE_FIREBASE_STORAGE_BUCKET=lyoo-7cc38.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=437989938810
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
