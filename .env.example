# ==============================================================================
# NEXUS OS • BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# (Deploy on: Render, Railway, DigitalOcean, VPS, etc.)
# ==============================================================================

# Server Environment & Port (Assigned dynamically on cloud platforms like Render/Railway)
NODE_ENV=production
PORT=10000

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Single Unified MongoDB Atlas Cluster)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.9vpk7q2.mongodb.net/nexus_os?retryWrites=true&w=majority
CENTRAL_MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.9vpk7q2.mongodb.net/nexus_os?retryWrites=true&w=majority
CRM_MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.9vpk7q2.mongodb.net/nexus_os?retryWrites=true&w=majority
WEBSITE_MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.9vpk7q2.mongodb.net/nexus_os?retryWrites=true&w=majority
ANALYTICS_MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.9vpk7q2.mongodb.net/nexus_os?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION TOKENS
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_central_saas_platform_key_2026
CRM_JWT_SECRET=Tarasaka_supersecrectKey$2028
FIREBASE_PROJECT_ID=lyoo-7cc38

# ------------------------------------------------------------------------------
# 3. CORS & REDIRECT URLS (Set to your actual deployed frontend URL)
# ------------------------------------------------------------------------------
CLIENT_URL=https://your-frontend.vercel.app
ADMIN_URL=https://your-admin-portal.vercel.app

# ------------------------------------------------------------------------------
# 4. AI & INTELLIGENCE ENGINES
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 5. SOCIAL MEDIA (MEDIAMATION) CREDENTIALS
# (Optional: If left blank, the app will run in workspace simulation mode with 0 errors)
# ------------------------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://your-backend.onrender.com/api/accounts/facebook/callback

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://your-backend.onrender.com/api/accounts/linkedin/callback

