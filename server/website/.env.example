# Server Configuration
PORT=5000
NODE_ENV=development

# Google Gemini API Key (Optional: Can also be set directly in the Studio Settings UI)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration
FIREBASE_PROJECT_ID=lyoo-7cc38

# MongoDB Connection String (Supports local or MongoDB Atlas Cloud)
# e.g., mongodb://127.0.0.1:27017/pulse_studio or mongodb+srv://<user>:<password>@cluster.mongodb.net/pulse_studio
MONGODB_URI=mongodb://127.0.0.1:27017/pulse_studio
JWT_SECRET=pulse-studio-secure-mongodb-secret-2026